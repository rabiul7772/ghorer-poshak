{%- comment -%}
  Ghorer Poshak storefront head: Bangla font, design tokens and custom component styles.
  Rendered from layout/theme.liquid after the Horizon stylesheets so these win on equal specificity.
{%- endcomment -%}
<link rel="preload" href="{{ 'noto-sans-bengali-bengali.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<style>
  @font-face {
    font-family: 'Noto Sans Bengali';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: local('Noto Sans Bengali'), url({{ 'noto-sans-bengali-bengali.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0951-0952, U+0964-0965, U+0980-09FE, U+1CD0, U+1CD2, U+1CD5-1CD6, U+1CD8, U+1CE1, U+1CEA, U+1CED, U+1CF2, U+1CF5-1CF7, U+200C-200D, U+20B9, U+25CC, U+A8F1;
  }
  @font-face {
    font-family: 'Noto Sans Bengali';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: local('Noto Sans Bengali'), url({{ 'noto-sans-bengali-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  /* Horizon's header and footer groups sit outside `.rcb`; give them the Bangla stack too. */
  .shopify-section-group-header-group,
  .shopify-section-group-header-group *,
  .shopify-section-group-footer-group,
  .shopify-section-group-footer-group * {
    font-family: 'Noto Sans Bengali', 'Kohinoor Bangla', 'Bangla Sangam MN', 'Nirmala UI', system-ui, sans-serif !important;
  }
</style>
{{ 'rcb-storefront.css' | asset_url | stylesheet_tag }}
{{ 'rcb-core.css' | asset_url | stylesheet_tag }}
{{ 'rcb-sections.css' | asset_url | stylesheet_tag }}
{{ 'rcb-card-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rcb-card-motion.js' | asset_url }}" defer></script>
<script src="{{ 'rcb-nav.js' | asset_url }}" defer></script>
<script src="{{ 'rcb-announcement.js' | asset_url }}" defer></script>
