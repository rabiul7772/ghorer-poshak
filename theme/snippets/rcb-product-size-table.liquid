{%- doc -%}
  Default size chart table (inches, garment measurements) shown in the size-chart dialog when neither the
  product metafield custom.size_chart nor the theme's per-category chart image is set.

  Values are regular-fit medians of published Bangladeshi charts (Nov 2026): Aarong/Taaga Man, Blucheez,
  Easy, AAZ, Fabrilife, Follow Fashion, Axaro, Poripati, Poshak's BD. Every circumference column
  (chest, thigh, leg opening) is the full measurement around, not the flat/half measurement.

  @param {string} type - Lower-cased product type (pant / shirt / t-shirt)
  @param {boolean} [full_sleeve] - T-shirts only: the product is full sleeve. Shows chest and length only, marked as
    approximate: the shop has not measured these pieces, so the rows are the usual figures of Bangladeshi sellers
    for M/L/XL full-sleeve tees (lower end, so nobody is told a size is roomier than it is). Replace with real
    measurements when the shop has them.

  @example
  {% render 'rcb-product-size-table', type: 'pant' %}
{%- enddoc -%}
{%- liquid
  if type contains 'pant' or type contains 'প্যান্ট'
    # size | waist | length | thigh (around) | leg opening (around)
    assign head = 'সাইজ,কোমর,লম্বা,থাই,মুহুরি'
    assign rows = '28|28|39|22.5|13.5,30|30|39.5|23.5|14,32|32|40|24.5|14.5,34|34|40.5|25.5|15,36|36|41|26.5|15.5,38|38|41.5|27.5|16'
    assign tip = 'কোমরের মাপই সাইজ — যেমন কোমর ৩২ ইঞ্চি হলে ৩২ সাইজ। থাই ও মুহুরি চারপাশ ঘুরিয়ে মাপা।'
  elsif type contains 't-shirt' or type contains 'tshirt' or type contains 'টি-শার্ট'
    # size | chest (around) | length | sleeve | shoulder
    assign head = 'সাইজ,বুক,লম্বা,হাতা,কাঁধ'
    assign rows = 'M|39|27|7.5|17.5,L|41|28|8|18,XL|43|29|8.5|18.5,XXL|45|30|9|19'
    assign tip = 'বুক = টি-শার্টের বুকের চারপাশের মাপ। আপনার বুকের মাপের সাথে ২–৩ ইঞ্চি যোগ করে সাইজ বাছুন।'
    if full_sleeve
      assign head = 'সাইজ,বুক,লম্বা'
      assign rows = 'M|38|27,L|40|28,XL|42|29'
      assign tip = 'এগুলো আনুমানিক মাপ, ১ ইঞ্চি কমবেশি হতে পারে। বুক = টি-শার্টের বুকের চারপাশের মাপ। আপনার বুকের মাপের সাথে ২–৩ ইঞ্চি যোগ করে সাইজ বাছুন। হাতা ফুল, কবজি পর্যন্ত।'
    endif
  else
    # size | collar | chest (around) | length | sleeve (full) | shoulder
    assign head = 'সাইজ,কলার,বুক,লম্বা,হাতা,কাঁধ'
    assign rows = 'M|15.5|42|29|24.5|18,L|16|44|29.5|25|18.5,XL|16.5|46|30.5|25.5|19,XXL|17|48|31|26|19.5'
    assign tip = 'বুক = শার্টের বুকের চারপাশের মাপ। আপনার বুকের মাপের সাথে ৩–৪ ইঞ্চি যোগ করে সাইজ বাছুন; কলার সাইজ জানলে সেটা মিলিয়ে নিন।'
  endif
  assign head_cells = head | split: ','
  assign row_list = rows | split: ','
-%}
<div class="rcb-size-table" role="region" aria-label="সাইজ চার্ট" tabindex="0">
  <table>
    <thead>
      <tr>
        {%- for h in head_cells -%}<th scope="col">{{ h }}</th>{%- endfor -%}
      </tr>
    </thead>
    <tbody>
      {%- for r in row_list -%}
        {%- assign cells = r | split: '|' -%}
        <tr>
          {%- for c in cells -%}
            {%- if forloop.first -%}<th scope="row">{{ c }}</th>{%- else -%}<td>{% render 'rcb-bn', text: c %}"</td>{%- endif -%}
          {%- endfor -%}
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
<p class="rcb-size-table__tip">{{ tip }}</p>
<style>
  .rcb-size-table { overflow-x: auto; border: 1px solid var(--rcb-line); border-radius: 10px; }
  .rcb-size-table table { width: 100%; border-collapse: collapse; font: 500 .9375rem/1.5 var(--rcb-font); text-align: center; }
  .rcb-size-table thead th { background: var(--rcb-maroon); color: #fff; font-weight: 600; padding: .625rem .375rem; white-space: nowrap; }
  .rcb-size-table tbody th { background: var(--rcb-gold-soft); color: var(--rcb-ink); font-weight: 700; padding: .625rem .375rem; }
  .rcb-size-table td { padding: .625rem .375rem; border-top: 1px solid var(--rcb-line); white-space: nowrap; }
  .rcb-size-table tbody tr:nth-child(even) td { background: var(--rcb-tint); }
  .rcb-size-table__tip { margin: .75rem 0 0; color: var(--rcb-ink); font: 500 .875rem/1.6 var(--rcb-font); }
</style>
