{%- doc -%}
  Default size chart table (inches) shown in the size-chart dialog when neither the product metafield
  custom.size_chart nor the theme's per-category chart image is set.

  @param {string} type - Lower-cased product type (pant / shirt / t-shirt)

  @example
  {% render 'rcb-product-size-table', type: 'pant' %}
{%- enddoc -%}
{%- liquid
  if type contains 'pant' or type contains 'প্যান্ট'
    assign head = 'সাইজ,কোমর,লম্বা,থাই,মুহুরি'
    assign rows = '28|28|39|22|7.5,30|30|39.5|23|7.5,32|32|40|24|8,34|34|40.5|25|8,36|36|41|26|8.5,38|38|41.5|27|8.5'
  elsif type contains 't-shirt' or type contains 'tshirt' or type contains 'টি-শার্ট'
    assign head = 'সাইজ,বুক,লম্বা,হাতা'
    assign rows = 'M|38|27|7.5,L|40|28|8,XL|42|29|8.5,XXL|44|30|9'
  else
    assign head = 'সাইজ,বুক,লম্বা,হাতা,কাঁধ'
    assign rows = 'M|40|28|24|17.5,L|42|29|24.5|18,XL|44|30|25|18.5,XXL|46|31|25.5|19'
  endif
  assign head_cells = head | split: ','
  assign row_list = rows | split: ','
-%}
<div class="rcb-size-table" role="region" aria-label="সাইজ চার্ট" tabindex="0">
  <table>
    <thead>
      <tr>
        {%- for h in head_cells -%}<th scope="col">{{ h }}</th>{%- endfor -%}
      </tr>
    </thead>
    <tbody>
      {%- for r in row_list -%}
        {%- assign cells = r | split: '|' -%}
        <tr>
          {%- for c in cells -%}
            {%- if forloop.first -%}<th scope="row">{{ c }}</th>{%- else -%}<td>{% render 'rcb-bn', text: c %}"</td>{%- endif -%}
          {%- endfor -%}
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</div>
<style>
  .rcb-size-table { overflow-x: auto; border: 1px solid var(--rcb-line); border-radius: 10px; }
  .rcb-size-table table { width: 100%; border-collapse: collapse; font: 500 .9375rem/1.5 var(--rcb-font); text-align: center; }
  .rcb-size-table thead th { background: var(--rcb-maroon); color: #fff; font-weight: 600; padding: .625rem .5rem; }
  .rcb-size-table tbody th { background: var(--rcb-gold-soft); color: var(--rcb-ink); font-weight: 700; padding: .625rem .5rem; }
  .rcb-size-table td { padding: .625rem .5rem; border-top: 1px solid var(--rcb-line); }
  .rcb-size-table tbody tr:nth-child(even) td { background: var(--rcb-tint); }
</style>
