{%- doc -%}
  Ghorer Poshak mega menu body: department header with an "all" link, editorial columns of
  category groups, and a spotlight column of featured products. Styled by the
  `#header-component .rcb-mm-*` rules in assets/rcb-storefront.css.

  Menu shape: top-level link → 2nd-level links → 3rd-level links.
  - A 2nd-level link WITH children becomes a group (its title) listing its children.
  - Consecutive 2nd-level links WITHOUT children are gathered into one "জনপ্রিয় ক্যাটাগরি" group.

  @param {object} parent_link - Top-level menu link that has children.
  @param {string} id - Unique list ID, e.g. 'MegaMenuList-2'.
  @param {object} [section] - Header section; featured products load only through the Section Rendering API.

  @example
  {% render 'rcb-mm-list', parent_link: link, id: 'MegaMenuList-2', section: section %}
{%- enddoc -%}

{%- liquid
  assign eager_loading = false
  if section.index == blank
    assign eager_loading = true
  endif

  assign collection_object = nil
  if parent_link.type == 'collection_link'
    assign collection_object = parent_link.object
  elsif parent_link.type == 'catalog_link' or parent_link.type == 'collections_link'
    assign collection_object = collections.all
  endif

  assign heading = parent_link.title | append: ' কালেকশন'
  assign all_label = 'সব ' | append: parent_link.title | append: ' একসাথে দেখুন'
-%}

<div data-menu-list-id="{{ id }}" class="mega-menu__list list-unstyled rcb-mm-dept-list">
  <header class="rcb-mm-header">
    <div class="rcb-mm-heading">
      <span class="rcb-i">{% render 'rcb-icon', name: 'grid' %}</span>
      <span>{{ heading | escape }}</span>
    </div>
    <a href="{{ parent_link.url }}" class="rcb-mm-all-link">
      <span>{{ all_label | escape }}</span>
      <span aria-hidden="true" class="rcb-mm-arrow">→</span>
    </a>
  </header>

  <div class="rcb-mm-editorial-columns">
    {%- assign loose_items = '' -%}
    {%- for link in parent_link.links -%}
      {%- if link.links != blank -%}
        {%- if loose_items != blank -%}
          {%- render 'rcb-mm-group', title: 'জনপ্রিয় ক্যাটাগরি', items: loose_items -%}
          {%- assign loose_items = '' -%}
        {%- endif -%}
        {%- capture group_items -%}
          {%- for child in link.links -%}
            {%- render 'rcb-mm-item', link: child -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- render 'rcb-mm-group', title: link.title, items: group_items -%}
      {%- else -%}
        {%- capture item -%}{%- render 'rcb-mm-item', link: link -%}{%- endcapture -%}
        {%- assign loose_items = loose_items | append: item -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if loose_items != blank -%}
      {%- render 'rcb-mm-group', title: 'জনপ্রিয় ক্যাটাগরি', items: loose_items -%}
    {%- endif -%}
  </div>
</div>

{% style %}
  [data-menu-grid-id="{{ id }}"] {
    --menu-columns-desktop: 6;
    --menu-columns-tablet: 4;
  }

  [data-menu-list-id="{{ id }}"] {
    --menu-columns-desktop: 4;
    --menu-columns-tablet: 4;
  }
{% endstyle %}

<div class="mega-menu__content" style="--menu-content-columns-desktop: 2; --menu-content-columns-tablet: 2; --resource-card-corner-radius: 0px;">
  <div class="rcb-mm-spotlight-head">
    <div class="rcb-mm-spotlight-title">
      <span class="rcb-i">{% render 'rcb-icon', name: 'sparkle' %}</span>
      <span>{{ parent_link.title | escape }}</span>
    </div>
  </div>
  <ul class="mega-menu__content-list mega-menu__content-list--products list-unstyled">
    {%- if eager_loading and collection_object != blank -%}
      {%- capture image_sizes -%}
        {%- render 'util-mega-menu-img-sizes-attr', menu_content_type: 'featured_products', settings: settings, grid_columns: 6, grid_columns_tablet: 4 -%}
      {%- endcapture -%}
      {%- for item in collection_object.products limit: 2 -%}
        <li class="mega-menu__content-list-item">
          {% render 'resource-card',
            resource: item,
            resource_type: 'product',
            image_hover: true,
            image_aspect_ratio: '4 / 5',
            image_sizes: image_sizes,
            product_view_context: 'dialog'
          %}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>
