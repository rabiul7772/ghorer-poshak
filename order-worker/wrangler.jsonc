{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghorer-poshak-order",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "order.ghorerposhak.com", "custom_domain": true }],
  "vars": {
    "SHOPIFY_SHOP": "y1wdm0-c1",
    "ALLOWED_ORIGINS": "https://ghorerposhak.com,https://www.ghorerposhak.com,https://y1wdm0-c1.myshopify.com,http://127.0.0.1:9292",
    "DELIVERY_INSIDE": "80",
    "DELIVERY_OUTSIDE": "120",
    "MAX_ORDERS_PER_IP_HOUR": "6",
    "MAX_ORDERS_PER_PHONE_HOUR": "4"
  },
  // Created with: npx wrangler kv namespace create ORDERS  (paste the id it prints below)
  "kv_namespaces": [{ "binding": "ORDERS", "id": "00ae1742b3584d84919026afeefaae2c" }]
  // Secrets (never in this file): npx wrangler secret put SHOPIFY_CLIENT_ID / SHOPIFY_CLIENT_SECRET
}
